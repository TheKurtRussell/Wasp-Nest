# Honeycomb C6 radio service — build defaults
# Target: esp32c6  (idf.py set-target esp32c6)

# --- IEEE 802.15.4 ---
CONFIG_IEEE802154_ENABLED=y
CONFIG_IEEE802154_RX_BUFFER_SIZE=32
# Promiscuous captures need generous RX buffering; the sniffer copies+releases
# each frame immediately but headroom avoids drops under bursty traffic.

# --- Console on the C6's own USB-serial-jtag (for standalone debugging) ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- FreeRTOS ---
CONFIG_FREERTOS_HZ=1000

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# NOTE: the inter-chip link currently uses UART1 (see hc_link_slave.c). When you
# move the link onto SDIO (phase 2, shared with esp_hosted), add the esp_hosted
# slave config here and flip HC_LINK_TRANSPORT.

# --- BLE (NimBLE observer; the ble-scanner recon mode) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n

# --- Flash + partitions: the BLE stack pushes the app past the default 1 MB,
# so use a 4 MB flash image and a 2 MB factory app partition. ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
